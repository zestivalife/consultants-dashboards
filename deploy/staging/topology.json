{
  "environment": "integrated-staging",
  "production_access": false,
  "services": [
    "consultant-frontend", "api-gateway", "auth-service", "profile-service",
    "practice-operations-service", "assessment-service", "nutrition-service",
    "scoring-engine-service", "fiteatsy-backend"
  ],
  "data_services": {
    "postgres": {"host": "postgres-integrated-staging.railway.internal", "database": "consultant_staging", "storage_gb": 2},
    "redis": {"host": "redis-integrated-staging.railway.internal", "storage_gb": 1}
  },
  "safety": {
    "database_environment": "staging",
    "notification_mode": "sink",
    "allowed_email_domains": ["example.test"],
    "deny_production_credentials": true,
    "deny_production_hosts": true
  },
  "resource_limits": {
    "application_service": {"vcpu": 0.25, "memory_mb": 256},
    "postgres": {"vcpu": 0.5, "memory_mb": 512},
    "redis": {"vcpu": 0.25, "memory_mb": 256}
  },
  "idle_policy": {"application_services": "sleep_when_inactive", "databases": "retain_and_scale_to_minimum"}
}
